{
  "name": "@localwebauthn/client",
  "version": "3.1.0",
  "description": "Software WebAuthn authenticator and DPoP client for headless API access",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./file-key": {
      "types": "./dist/file-key.d.ts",
      "import": "./dist/file-key.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/file-key.ts --format esm --dts --clean"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LocalWebAuthn/LocalWebAuthn.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/LocalWebAuthn/LocalWebAuthn/issues"
  },
  "homepage": "https://github.com/LocalWebAuthn/LocalWebAuthn#readme",
  "keywords": [
    "passkey",
    "webauthn",
    "dpop",
    "api",
    "machine-to-machine"
  ]
}
